#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_store
# ─── Base de datos (PostgreSQL — igual que u_05_v2) ──────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=seguridad_jwt_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-super-secret-key-32-chars-minimo-cambiar
ALGORITHM=HS256
    ACCESS_TOKEN_EXPIRE_MINUTES=30
