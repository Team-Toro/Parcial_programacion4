# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=food_store
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-super-secret-key-de-al-menos-32-caracteres-cambiar-en-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MercadoPago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-tu-access-token
MP_PUBLIC_KEY=APP_USR-tu-public-key

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ─── NGROK (para webhooks MP en desarrollo) ───────────────────────────────────
# NGROK_URL lo lee el backend FastAPI (config.py) para construir los back_urls de MP
NGROK_URL=https://tu-subdominio.ngrok-free.dev

# ─── NGROK docker-compose ──────────────────────────────────────────────────────
# Estas dos variables las lee docker-compose del .env raíz del proyecto (mismo nivel que docker-compose.yml)
# 1. Crear cuenta en https://ngrok.com → Dashboard → Your Authtoken → copiar
# 2. Crear un dominio fijo: ngrok → Domains → New Domain (opcional, se puede dejar vacío)
# 3. Pegar en el .env raíz del proyecto (NO en este archivo):
#    NGROK_AUTHTOKEN=tu-authtoken-aqui
#    NGROK_DOMAIN=tu-subdominio.ngrok-free.app
# El dashboard de NGROK queda en http://localhost:4040
NGROK_AUTHTOKEN=tu-authtoken-de-ngrok
NGROK_DOMAIN=tu-subdominio.ngrok-free.app

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
